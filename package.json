{
  "name": "@jabrailkhalil/course-update-lab",
  "version": "0.1.0",
  "private": true,
  "license": "BSD-3-Clause",
  "description": "Review course notebook updates while keeping learner work",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "style": "style/index.css",
  "scripts": {
    "build:lib": "tsc",
    "build": "npm run build:lib && jupyter-builder build .",
    "test:unit": "node --test --test-reporter=tap tests/merge.test.mjs tests/render.test.mjs tests/transport.test.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@jupyterlab/application": "4.6.5",
    "@jupyterlab/apputils": "4.7.5",
    "@jupyterlab/coreutils": "6.6.5",
    "@jupyterlab/notebook": "4.6.5",
    "@jupyterlab/services": "7.6.5",
    "@lumino/disposable": "2.1.5",
    "@lumino/widgets": "2.8.0"
  },
  "devDependencies": {
    "@jupyter/builder": "1.2.4",
    "@playwright/test": "1.65.0",
    "typescript": "5.9.3"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "course_update/labextension",
    "sharedPackages": {
      "@jupyterlab/application": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": "4.6.5"
      },
      "@jupyterlab/apputils": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": "4.7.5"
      },
      "@jupyterlab/coreutils": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": "6.6.5"
      },
      "@jupyterlab/notebook": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": "4.6.5"
      },
      "@jupyterlab/services": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": "7.6.5"
      },
      "@lumino/disposable": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": "2.1.5"
      },
      "@lumino/widgets": {
        "bundled": false,
        "singleton": true,
        "requiredVersion": "2.8.0"
      }
    }
  }
}
